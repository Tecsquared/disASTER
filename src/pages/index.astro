---
// disASTER — Newsletter Landing Page
import '../styles/global.css';
---

<html lang="en">
<head>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>disASTER — A newsletter by Damien Herlihy</title>
  <meta name="description" content="A short newsletter on language, learning, and the beautiful mess of teaching." />
  <meta property="og:title" content="disASTER — A newsletter by Damien Herlihy" />
  <meta property="og:description" content="A short newsletter on language, learning, and the beautiful mess of teaching." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://dis-aster.vercel.app/" />
  <meta property="og:image" content="https://dis-aster.vercel.app/images/disaster-black-hole-poster.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://dis-aster.vercel.app/images/disaster-black-hole-poster.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />

  <!-- Fonts: Manrope + Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet" />
</head>

<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="landing" tabindex="-1">

    <!-- Hero -->
    <section class="hero">
      <div class="container hero-container reveal-stagger">
        <div class="hero-media reveal">
          <video
            id="hero-video"
            class="hero-video"
            width="1280"
            height="720"
            poster="/images/disaster-black-hole-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Animated black hole with learning objects orbiting it"
          >
            <source src="/images/disaster-black-hole-loop.mp4" type="video/mp4" />
          </video>
          <button
            class="video-toggle"
            type="button"
            aria-controls="hero-video"
            aria-label="Pause animation"
            data-video-toggle
          >
            <span class="video-toggle-icon" aria-hidden="true">&#8545;</span>
          </button>
        </div>
        <h1 class="tagline reveal">
          From a language teacher who never stopped being a learner
        </h1>
        <a class="hero-cta reveal" href="#subscribe">
          Join the constellation <span aria-hidden="true">&darr;</span>
        </a>
        <div class="orbit-divider reveal" aria-hidden="true">
          <span>&#10022;</span>
        </div>
      </div>
    </section>

    <!-- Pitch -->
    <section class="pitch">
      <div class="container">
        <p class="pitch-text reveal">
          I've spent 25 years watching the gap between knowing and doing play out in language classrooms. Students who know the grammar but freeze when speaking. Teachers who know the research but default to the same lesson.
        </p>
        <p class="pitch-text pitch-highlight reveal">
          That gap? It's a <span class="dis-inline">dis</span>ASTER.
        </p>
        <p class="pitch-text reveal">
          I started this newsletter to find the star in disaster. I write about online language teaching and learning, share Notion templates from Language Layouts, and try to make sense of the moment we're in — where large language models are changing what it means to learn a language.
        </p>
      </div>
    </section>

    <!-- Subscribe -->
    <section class="subscribe" id="subscribe" aria-labelledby="subscribe-heading">
      <div class="subscribe-inner reveal">
        <h2 class="subscribe-heading" id="subscribe-heading">
          Join <em>the</em> constellation
        </h2>
        <p class="subscribe-copy">
          Short notes on language, learning, AI, and the beautiful mess of teaching.
        </p>
        <div id="audienceful-5qfwcu">
          <p data-audienceful-fallback>
            JavaScript is off — <a href="mailto:damienmunchip@gmail.com?subject=Subscribe%20to%20disASTER">email me and I'll add you</a>
          </p>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="footer-whisper">
    <p>From Damien Herlihy — teacher, learner, maker. &middot; <a class="footer-link" href="/privacy">Privacy</a></p>
  </footer>

  <!-- Audienceful -->
  <script is:inline data-orgid="org_Zaaub6fq" src="https://cdn.audiencefulapp.net/forms/audienceful.min.js"></script>

  <!-- Audienceful accessibility and no-JS fallback patch -->
  <script is:inline>
    (() => {
      const container = document.querySelector('#audienceful-5qfwcu');
      if (!container) return;

      const patchAudiencefulForm = () => {
        const emailInput = container.querySelector('input[type="email"]');
        if (!emailInput) return;

        emailInput.id = 'af-email';
        emailInput.setAttribute('autocomplete', 'email');

        let label = container.querySelector('label[for="af-email"]');
        if (!label) {
          label = document.createElement('label');
          label.className = 'visually-hidden';
          label.htmlFor = 'af-email';
          label.textContent = 'Email address';
          emailInput.before(label);
        }

        const fallback = container.querySelector('[data-audienceful-fallback]');
        if (fallback) fallback.hidden = true;
      };

      patchAudiencefulForm();
      window.addEventListener('load', patchAudiencefulForm, { once: true });
      new MutationObserver(patchAudiencefulForm).observe(container, {
        childList: true,
        subtree: true,
      });
    })();
  </script>

  <!-- Scroll Reveal Observer -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const heroVideo = document.querySelector('.hero-video');
      const videoToggle = document.querySelector('[data-video-toggle]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (heroVideo && reducedMotion.matches) {
        heroVideo.pause();
      }

      const syncVideoToggle = () => {
        if (!heroVideo || !videoToggle) return;
        const isPaused = heroVideo.paused;
        videoToggle.setAttribute('aria-label', isPaused ? 'Play animation' : 'Pause animation');
        const icon = videoToggle.querySelector('.video-toggle-icon');
        if (icon) icon.textContent = isPaused ? '\u25B6' : '\u2161';
      };

      if (heroVideo && videoToggle) {
        videoToggle.addEventListener('click', () => {
          if (heroVideo.paused) {
            heroVideo.play();
          } else {
            heroVideo.pause();
          }
        });
        heroVideo.addEventListener('play', syncVideoToggle);
        heroVideo.addEventListener('pause', syncVideoToggle);
        syncVideoToggle();
      }

      const reveals = document.querySelectorAll('.reveal');
      if (!reveals.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      reveals.forEach(el => observer.observe(el));
    });
  </script>
</body>
</html>

<style>
  /* ===== Hero ===== */
  .hero {
    padding-top: 64px;
    padding-bottom: 28px;
    text-align: center;
  }

  .hero-container {
    max-width: 840px;
  }

  .hero-media {
    position: relative;
    max-width: 760px;
    margin: 0 auto 28px;
  }

  .hero-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #08080e;
  }

  .video-toggle {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(214, 179, 106, 0.72);
    border-radius: 999px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.72);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .video-toggle:hover {
    border-color: var(--color-gold);
    background: rgba(0, 0, 0, 0.9);
    transform: translateY(-1px);
  }

  .video-toggle:focus-visible,
  .hero-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .tagline {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 28px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.45;
    max-width: 560px;
    margin: 0 auto;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding: 10px 17px;
    border: 1px solid rgba(214, 179, 106, 0.68);
    border-radius: 999px;
    color: var(--color-gold);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .hero-cta:hover {
    color: #000000;
    background: var(--color-gold);
    border-color: var(--color-gold);
  }

  .orbit-divider {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 180px;
    margin: 34px auto 0;
    color: var(--color-gold);
    font-size: 11px;
  }

  .orbit-divider::before,
  .orbit-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(214, 179, 106, 0.7));
  }

  .orbit-divider::after {
    transform: scaleX(-1);
  }

  /* ===== Pitch ===== */
  .pitch {
    padding: 12px 0 64px;
    text-align: center;
  }

  .pitch-text {
    font-family: var(--font-body);
    font-size: 19px;
    font-weight: 400;
    color: var(--color-text);
    max-width: 540px;
    margin: 0 auto 1.4em;
    line-height: 1.78;
    text-align: left;
  }

  .pitch-text:last-child {
    margin-bottom: 0;
  }

  .pitch-highlight {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-gold);
    text-align: center;
  }

  .dis-inline {
    font-weight: 400;
  }

  /* ===== Subscribe (adapted from DamienHerlihy) ===== */
  .subscribe {
    scroll-margin-top: 32px;
    background: #090909;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 54px 44px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto 72px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(214, 179, 106, 0.08);
  }

  .subscribe-inner {
    max-width: 100%;
    margin: 0 auto;
  }

  .subscribe-heading {
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 40px;
    font-weight: 700;
    margin-bottom: 14px;
    line-height: 1.15;
  }

  .subscribe-heading em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
  }

  .subscribe-copy {
    max-width: 420px;
    margin: 0 auto 28px;
    color: var(--color-text-light);
    font-size: 16px;
    line-height: 1.65;
  }

  /* ===== Footer ===== */
  .footer-whisper {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 30px var(--content-padding) 36px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-light);
    font-size: 14px;
  }

  .footer-whisper .footer-link {
    color: var(--color-text-light);
    text-decoration: underline;
  }

  .footer-whisper .footer-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 24px;
    }

    .hero-media {
      max-width: 100%;
      margin-bottom: 24px;
    }

    .tagline {
      font-size: 22px;
      max-width: 440px;
    }

    .orbit-divider {
      margin-top: 28px;
    }

    .pitch {
      padding-bottom: 48px;
    }

    .pitch-text {
      font-size: 17px;
      line-height: 1.75;
    }

    .subscribe {
      border-radius: 12px;
      padding: 40px 24px;
      margin: 0 20px 56px;
    }

    .subscribe-heading {
      font-size: 28px;
    }

    .footer-whisper {
      margin: 0 20px;
      padding-inline: 0;
    }
  }

  @media (max-width: 480px) {
    .tagline {
      font-size: 20px;
    }

    .hero-cta {
      font-size: 12px;
    }
  }
</style>
