---
// disASTER — Newsletter Landing Page
import '../styles/global.css';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>disASTER — A newsletter by Damien Herlihy</title>
  <meta name="description" content="A short newsletter on language, learning, and the beautiful mess of teaching." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts: Manrope + Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet" />
</head>

<body>
  <main class="landing">

    <!-- Hero -->
    <section class="hero">
      <div class="container reveal-stagger">
        <video
          class="hero-video reveal"
          width="1280"
          height="720"
          poster="/images/disaster-black-hole-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="/images/disaster-black-hole-loop.mp4" type="video/mp4" />
        </video>
        <h1 class="brand-name reveal">
          <span class="dis">dis</span>ASTER
        </h1>
        <p class="tagline reveal">
          From a language teacher who never stopped being a learner
        </p>
      </div>
    </section>

    <!-- Pitch -->
    <section class="pitch">
      <div class="container">
        <p class="pitch-text reveal">
          I've spent 25 years watching the gap between knowing and doing play out in language classrooms. Students who know the grammar but freeze when speaking. Teachers who know the research but default to the same lesson.
        </p>
        <p class="pitch-text pitch-highlight reveal">
          That gap? It's a <span class="dis-inline">dis</span>ASTER.
        </p>
        <p class="pitch-text reveal">
          I started this newsletter to find the star in disaster. I write about online language teaching and learning, share Notion templates from Language Layouts, and try to make sense of the moment we're in — where large language models are changing what it means to learn a language.
        </p>
      </div>
    </section>

    <!-- Subscribe -->
    <section class="subscribe">
      <div class="subscribe-inner reveal">
        <h2 class="subscribe-heading">
          Join <em>the</em> constellation
        </h2>
        <div id="audienceful-5qfwcu"></div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer-whisper">
      <p>From Damien Herlihy — teacher, learner, maker.</p>
    </footer>

  </main>

  <!-- Audienceful -->
  <script is:inline data-orgid="org_Zaaub6fq" src="https://cdn.audiencefulapp.net/forms/audienceful.min.js"></script>

  <!-- Scroll Reveal Observer -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const heroVideo = document.querySelector('.hero-video');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (heroVideo && reducedMotion.matches) {
        heroVideo.pause();
      }

      const reveals = document.querySelectorAll('.reveal');
      if (!reveals.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      reveals.forEach(el => observer.observe(el));
    });
  </script>
</body>
</html>

<style>
  /* ===== Hero ===== */
  .hero {
    padding-top: 80px;
    padding-bottom: 40px;
    text-align: center;
  }

  .hero-video {
    display: block;
    margin: 0 auto 40px;
    max-width: 720px;
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #08080e;
  }

  .brand-name {
    font-family: var(--font-body);
    font-size: 80px;
    font-weight: 800;
    color: var(--color-black);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 16px;
  }

  .brand-name .dis {
    font-weight: 400;
  }

  .tagline {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 20px;
    color: var(--color-text-light);
    max-width: 400px;
    margin: 0 auto;
  }

  /* ===== Pitch ===== */
  .pitch {
    padding: 20px 0 60px;
    text-align: center;
  }

  .pitch-text {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    color: var(--color-text);
    max-width: 480px;
    margin: 0 auto 1.2em;
    line-height: 1.7;
    text-align: left;
  }

  .pitch-text:last-child {
    margin-bottom: 0;
  }

  .pitch-highlight {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-black);
    text-align: center;
  }

  .dis-inline {
    font-weight: 400;
  }

  /* ===== Subscribe (adapted from DamienHerlihy) ===== */
  .subscribe {
    background: var(--color-black);
    border-radius: var(--radius);
    padding: 48px 40px;
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .subscribe-inner {
    max-width: 100%;
    margin: 0 auto;
  }

  .subscribe-heading {
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 40px;
    font-weight: 700;
    margin-bottom: 24px;
    line-height: 1.15;
  }

  .subscribe-heading em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
  }

  /* ===== Footer ===== */
  .footer-whisper {
    text-align: center;
    padding: 48px var(--content-padding);
    color: var(--color-text-light);
    font-size: 14px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .hero {
      padding-top: 48px;
    }

    .hero-video {
      max-width: 100%;
      margin-bottom: 28px;
    }

    .brand-name {
      font-size: 56px;
    }

    .tagline {
      font-size: 17px;
    }

    .subscribe {
      border-radius: 0;
      padding: 40px 24px;
      margin: 0;
    }

    .subscribe-heading {
      font-size: 28px;
    }
  }

  @media (max-width: 480px) {
    .brand-name {
      font-size: 44px;
    }

    .pitch-text {
      font-size: 16px;
    }
  }
</style>
