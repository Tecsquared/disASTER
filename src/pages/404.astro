---
import '../styles/global.css';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page not found — disASTER</title>
  <meta name="description" content="The page you were looking for could not be found." />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet" />
</head>

<body class="not-found-page">
  <a href="#main" class="skip-link">Skip to content</a>
  <main id="main" class="not-found" tabindex="-1">
    <div class="not-found-orbit" aria-hidden="true">
      <span>&#10022;</span>
    </div>
    <p class="not-found-kicker">Lost in the constellation</p>
    <h1>Page not found</h1>
    <p>The page you're looking for isn't here.</p>
    <a class="not-found-link" href="/">Return to disASTER</a>
  </main>
  <footer class="footer-whisper">
    <p>From Damien Herlihy — teacher, learner, maker.</p>
  </footer>
</body>
</html>

<style>
  .not-found-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% 42%, rgba(214, 179, 106, 0.12), transparent 1px),
      radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.48), transparent 1px),
      radial-gradient(circle at 82% 68%, rgba(255, 255, 255, 0.34), transparent 1px),
      #000000;
    background-size: 100% 100%, 180px 180px, 240px 240px, auto;
  }

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 112px);
    padding: 64px var(--content-padding);
    text-align: center;
  }

  .not-found-orbit {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    margin-bottom: 30px;
    border: 1px solid rgba(214, 179, 106, 0.48);
    border-radius: 50%;
    color: var(--color-gold);
    box-shadow: inset 0 0 45px rgba(214, 179, 106, 0.08), 0 0 70px rgba(214, 179, 106, 0.08);
    font-size: 24px;
  }

  .not-found-kicker {
    margin-bottom: 10px;
    color: var(--color-gold);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .not-found h1 {
    margin-bottom: 14px;
    color: #ffffff;
    font-size: clamp(36px, 7vw, 64px);
    line-height: 1.1;
  }

  .not-found > p:not(.not-found-kicker) {
    color: var(--color-text-light);
    font-family: var(--font-accent);
    font-size: 20px;
    font-style: italic;
  }

  .not-found-link {
    margin-top: 30px;
    padding: 10px 17px;
    border: 1px solid rgba(214, 179, 106, 0.68);
    border-radius: 999px;
    color: var(--color-gold);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .not-found-link:hover {
    color: #000000;
    background: var(--color-gold);
    border-color: var(--color-gold);
  }

  .not-found-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .not-found-page .footer-whisper {
    max-width: 560px;
    margin: 0 auto;
    padding: 30px var(--content-padding) 36px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-light);
    font-size: 14px;
    text-align: center;
  }
</style>
